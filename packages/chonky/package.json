{
  "name": "@samuelncui/chonky",
  "version": "0.3.0",
  "description": "A File Browser component for React",
  "license": "MIT",
  "main": "dist/chonky.cjs",
  "module": "dist/chonky.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/chonky.esm.js",
      "require": "./dist/chonky.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc6 --project tsconfig.build.json",
    "typecheck": "tsc6 --project tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/fuzzy-search": "^2.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.3.1",
    "@reduxjs/toolkit": "^2.12.0",
    "classnames": "^2.5.1",
    "deepmerge": "^4.3.0",
    "exact-trie": "^1.0.13",
    "fast-sort": "^3.2.1",
    "filesize": "^11.0.22",
    "fuzzy-search": "^3.2.1",
    "hotkeys-js": "^3.8.3",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-intl": "^10.1.22",
    "react-redux": "^9.3.0",
    "react-virtuoso": "^4.18.12",
    "tsdef": "^0.0.14"
  },
  "homepage": "https://chonky.io/",
  "author": {
    "name": "Timur Kuzhagaliyev",
    "email": "tim.kuzh@gmail.com",
    "url": "https://foxypanda.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelncui/Chonky.git"
  },
  "bugs": {
    "url": "https://github.com/samuelncui/Chonky/issues"
  },
  "keywords": [
    "file",
    "chonky",
    "file-dialog",
    "file-browser",
    "react-component"
  ]
}
