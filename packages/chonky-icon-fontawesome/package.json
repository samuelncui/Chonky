{
  "name": "@samuelncui/chonky-icon-fontawesome",
  "version": "0.3.0",
  "description": "FontAwesome icon component for Chonky file browser",
  "license": "MIT",
  "main": "dist/chonky-icon-fontawesome.cjs",
  "module": "dist/chonky-icon-fontawesome.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/chonky-icon-fontawesome.esm.js",
      "require": "./dist/chonky-icon-fontawesome.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc6 --project tsconfig.build.json",
    "pretypecheck": "pnpm --filter @samuelncui/chonky build",
    "typecheck": "tsc6 --project tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@samuelncui/chonky": "workspace:^",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0"
  },
  "homepage": "https://chonky.io/",
  "author": {
    "name": "Timur Kuzhagaliyev",
    "email": "tim.kuzh@gmail.com",
    "url": "https://foxypanda.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelncui/Chonky.git"
  },
  "bugs": {
    "url": "https://github.com/samuelncui/Chonky/issues"
  },
  "keywords": [
    "file",
    "chonky",
    "file-dialog",
    "file-browser",
    "react-component"
  ]
}
